{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Frontend", "start"],
      "port": 8081
    },
    {
      "name": "frontend-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Frontend", "run", "web"],
      "port": 8081
    },
    {
      "name": "frontend-clean",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Frontend", "run", "start", "--", "-c"],
      "port": 8081
    },
    {
      "name": "frontend-web-clean",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Frontend", "run", "web", "--", "-c", "--port", "8090"],
      "port": 8090,
      "autoPort": false
    }
  ]
}
