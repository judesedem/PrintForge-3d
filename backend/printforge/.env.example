# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/printforge
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT — generate a secure base64 key (min 32 bytes)
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your_base64_jwt_secret

# Cloudinary — from your Cloudinary dashboard → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack — from your Paystack dashboard → Settings → API Keys
# Use sk_test_... for development, sk_live_... for production
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
