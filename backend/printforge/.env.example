# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
JWT_SECRET=replace-with-a-long-random-base64-string

spring.datasource.url=jdbc:postgresql://localhost:5432/printforge_db
spring.datasource.username=postgres
spring.datasource.password=your-db-password

# ===== Admin Seeder =====
# Bootstraps the first ADMIN account on startup (see
# config/AdminSeeder.java) — creating an admin normally requires an
# existing admin, so there's otherwise no way to create the very first
# one. If ADMIN_PASSWORD is left unset, the seeder skips silently and no
# admin account is created — don't set a default password here.
ADMIN_EMAIL=admin@printforge.com
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# ===== Lab Location Seeder =====
# Bootstraps a default lab location on startup (see
# config/LabLocationSeeder.java) — idempotent, skipped once any
# LabLocation row exists.
LAB_NAME=KNUST 3D Printing Lab
LAB_ADDRESS=Engineering Block, KNUST, Kumasi
LAB_LATITUDE=6.6745
LAB_LONGITUDE=-1.5716
