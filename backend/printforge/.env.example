# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets.

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key
JWT_SECRET=replace-with-a-long-random-base64-string

# ===== Database =====
# Optional — local dev works with zero setup even if these are left
# unset (falls back to localhost:5432/printforge_db, postgres/admin).
# Only set these to point at something else (a shared dev Postgres, a
# Neon instance, etc). NOTE: an existing local .env on this machine may
# instead set the literal spring.datasource.url/.username/.password
# keys directly — spring-dotenv passes any key through as-is, and that
# direct form always takes priority over DB_* below if both are present.
# Both are valid; DB_* is just the one documented in
# application.properties going forward.
DB_URL=jdbc:postgresql://localhost:5432/printforge_db?reWriteBatchedInserts=true
DB_USERNAME=postgres
DB_PASSWORD=your-db-password

# ===== Admin Seeder =====
# Bootstraps the first ADMIN account on startup (see
# config/AdminSeeder.java) — creating an admin normally requires an
# existing admin, so there's otherwise no way to create the very first
# one. If ADMIN_PASSWORD is left unset, the seeder skips silently and no
# admin account is created — don't set a default password here.
ADMIN_EMAIL=admin@printforge.com
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# ===== Email (SMTP) =====
# General-purpose templated email infra (see emailservice/). Not yet
# wired into any real flow. Defaults to Gmail's SMTP relay if left unset
# — for Gmail, MAIL_PASSWORD must be a Google App Password, not your
# regular account password. SPF/DKIM/DMARC still need to be configured
# in DNS for whichever domain MAIL_FROM uses, before this goes live.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password-or-app-password
MAIL_FROM=no-reply@printforge.example
MAIL_FROM_NAME=PrintForge

# Frontend page POST /api/auth/forgot-password's reset link points at —
# ?token=... is appended automatically. Update for the real frontend
# domain/deep link once one exists.
FRONTEND_RESET_PASSWORD_URL=http://localhost:8081/reset-password

# ===== Lab Location Seeder =====
# Bootstraps a default lab location on startup (see
# config/LabLocationSeeder.java) — idempotent, skipped once any
# LabLocation row exists.
LAB_NAME=KNUST 3D Printing Lab
LAB_ADDRESS=Engineering Block, KNUST, Kumasi
LAB_LATITUDE=6.6745
LAB_LONGITUDE=-1.5716
