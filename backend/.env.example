# Local development template. Copy to backend/.env and fill in.
# For Render, these same names are set in the dashboard — see
# docs/RENDER_DEPLOYMENT.md and render.yaml (which groups them).

# Common Database Config (all services share one Postgres)
DB_URL=jdbc:postgresql://postgres:5432/printforge_db
DB_USERNAME=postgres
DB_PASSWORD=admin

# Gateway & Security — must be identical across gateway, auth and admin
JWT_SECRET=bXktc3VwZXItc2VjcmV0LWp3dC1rZXktZm9yLWxvY2FsLWRldi0xMjM0

# Service URLs (API Gateway routing). Docker-compose hostnames locally;
# on Render these are the public https://<name>.onrender.com URLs, because
# free web services can't receive private-network requests.
AUTH_SERVICE_URL=http://auth-service:8083
PRINTER_SERVICE_URL=http://printer-service:8082
ORDER_SERVICE_URL=http://order-service:8084
MARKETPLACE_SERVICE_URL=http://marketplace-service:8085
PAYMENT_SERVICE_URL=http://payment-service:8086
NOTIFICATION_SERVICE_URL=http://notification-service:8087
ADMIN_SERVICE_URL=http://admin-service:8088

# Cloudinary (Order & Marketplace)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Paystack (Payment Service)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Admin Setup (Notification & Admin Service seeder)
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@printforge.com
ADMIN_PASSWORD=secure_admin_password

# SMTP Email (Auth, Notification & Admin Service)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=no-reply@printforge.example
MAIL_FROM_NAME=PrintForge

# Password reset deep link (Auth Service)
FRONTEND_RESET_PASSWORD_URL=http://localhost:8081/reset-password

# RabbitMQ — optional. Unset means messaging is disabled and the services
# start without a broker (how Render runs). Set both to enable it.
# SPRING_RABBITMQ_HOST=rabbitmq
# RABBITMQ_EXCLUDE=
