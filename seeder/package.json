{
  "name": "printforge-seeder",
  "version": "1.0.0",
  "description": "Seeds PrintForge with real open-source 3D models, geometry-rendered thumbnails, accounts and printers",
  "private": true,
  "main": "seed.js",
  "type": "commonjs",
  "license": "ISC",
  "scripts": {
    "seed": "node seed.js",
    "seed:dry": "node seed.js --dry-run",
