{
  "expo": {
    "name": "PrintForge RN",
    "slug": "printforge3d",
    "version": "1.0.0",
    "scheme": "printforge",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
  
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.printforge.rn",
      "deploymentTarget": "16.4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FF5803"
      },
      "package": "com.printforge.rn"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
  "expo-splash-screen",
  {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#FF5803"
  }
],
      "expo-notifications"
    ],
    "userInterfaceStyle": "automatic",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "84f54efd-ae96-494c-a3bb-156656048f36"
      }
    },
    "owner": "printforge-3d-team"
  }
}
