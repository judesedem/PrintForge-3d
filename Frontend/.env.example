# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets to .env.example.

# Backend API base URL (see backend/printforge — defaults to localhost:8080 in dev)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Firebase (Project Settings > General > Your apps > SDK setup and configuration)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Web client ID (Google Cloud Console > APIs & Services > Credentials —
# used for the Firebase Google sign-in flow in SessionContext.tsx)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Paystack public key (Paystack dashboard > Settings > API Keys & Webhooks).
# Not currently read by any frontend code — the checkout flow opens the
# backend-provided checkoutUrl (Paystack's hosted page) in a browser
# session, which doesn't need the public key client-side. Kept here per
# convention / for a future inline-checkout or Paystack SDK integration.
EXPO_PUBLIC_PAYSTACK_KEY=pk_test_your_key_here
